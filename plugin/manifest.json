{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.kirkanos.ha-graph",
  "Name": "HA Graph",
  "Version": "0.0.0.0",
  "Author": "Andreas Hacker",
  "Description": "A Home Assistant sensor on a Stream Deck key: the current value with its history as a graph. Unofficial plugin, not affiliated with Home Assistant.",
  "URL": "https://github.com/kirkanos/Streamdeck-HA-Graph",
  "Icon": "images/icon",
  "Category": "HA Graph",
  "CategoryIcon": "images/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.kirkanos.ha-graph.graph",
      "Name": "Sensor Graph",
      "Icon": "images/actions/graph",
      "Tooltip": "Current value of a Home Assistant sensor with its history as a graph; press to open the history, hold to refresh",
      "PropertyInspectorPath": "ui/graph.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "images/key",
          "TitleAlignment": "top",
          "FontSize": 10,
          "ShowTitle": false
        }
      ]
    }
  ]
}
